{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "ignore": ["apple/**", "macos/**"],
  // Benchmarks run separately from Vitest's test.include patterns; skill
  // scripts are run directly with node.
  "entry": ["src/**/*.bench.ts", ".claude/skills/*/scripts/*.mjs", "docs/qa/179-shared-gear/lock-order.mjs", "docs/qa/233-overview-map/preview.mjs", "docs/qa/233-overview-map/preview/*.tsx", "docs/qa/234-day-map/preview.mjs", "docs/qa/234-day-map/preview/*.tsx"],
  "ignoreDependencies": [
    // Linked natively by ios/App/CapApp-SPM/Package.swift; never imported from JS.
    "@capacitor/splash-screen",
    // Loaded through postcss.config.mjs by Next's bundled PostCSS.
    "postcss",
    // Installed on demand by scripts/import-ski-resorts.mjs; too big for every install.
    "geo-tz"
  ],
  "ignoreIssues": {
    // Vendored shadcn/ui components keep their full upstream export surface.
    "src/components/ui/**": ["exports", "types"]
  }
}
